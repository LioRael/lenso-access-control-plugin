{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lenso Access Control D1 Plugin configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "auth_issuer",
    "auth_assertion_public_key",
    "bootstrap_callers",
    "binding"
  ],
  "properties": {
    "auth_issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "auth_assertion_public_key": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43
    },
    "bootstrap_callers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "directory_callers": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "binding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
