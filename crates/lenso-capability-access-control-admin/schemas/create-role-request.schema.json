{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "role_id", "name"],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {"kind": {"type": "string"}, "id": {"type": "string"}}
    },
    "role_id": {"type": "string"},
    "name": {"type": "string"}
  }
}
