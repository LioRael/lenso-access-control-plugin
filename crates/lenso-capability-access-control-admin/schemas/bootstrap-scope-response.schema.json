{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["created", "role_id", "policy_revision"],
  "properties": {
    "created": {"type": "boolean"},
    "role_id": {"type": "string"},
    "policy_revision": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
  }
}
